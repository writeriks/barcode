# Copy this file to .env and fill in real values once there's an AdMob
# account. Anything left unset falls back to Google's public test IDs, so
# the app keeps working with test ads until these are provided.

EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=

# PostHog analytics — leave unset to disable (there's no test-project
# fallback like there is for AdMob). Host is your PostHog Cloud region,
# e.g. https://us.i.posthog.com or https://eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# RevenueCat — iOS only for now. PROD is the live App Store Connect app's
# key; TEST is a separate RevenueCat project used for local/dev-client
# builds so sandbox purchases never mix with real production revenue.
# Leaving these unset disables premium purchases entirely (the paywall
# still renders with placeholder pricing, but "Continue" shows a
# store-unavailable message instead of buying anything).
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS_PROD=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS_TEST=

# Set to `true` to reveal the Settings rows that switch premium on without
# buying it and hand back the free document-scan allowance, so every gated
# feature can be exercised on a device. Debug builds show them anyway; this
# is for a locally-built Release, which is the closest thing to what ships
# and where __DEV__ is already false.
#
# Only ever affects a build made on your own machine: app.config.ts forces
# it off whenever EAS_BUILD is set, and eas.json pins it to "false" for the
# preview and production profiles, so it cannot ride along into anything
# EAS produces.
EXPO_PUBLIC_PREMIUM_TESTING=
